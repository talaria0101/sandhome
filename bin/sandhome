#!/bin/sh
# sandhome - the one command. POSIX sh; sources the library from the checkout it
# lives in, or from SANDHOME_REPO_DIR, so a copy installed under a prefix works.
set -u

SH_SELF=sandhome

# Resolve the repository directory: the environment wins, then this script's own
# path. A script read from a pipe has no path, and that case is refused rather
# than guessed, because sourcing the wrong library is worse than not starting.
# STOP: THE LIBRARY IS FOUND THROUGH SANDHOME_REPO_DIR FIRST. This copy of the
# script lives on the exec root, not in the checkout, so "the parent of $0" is
# the exec root and there is no lib/ under it. The bootstrap exports the
# checkout, and a copy that cannot find its library is a command that prints
# "cannot find the sandhome library" on every single call.
if [ -n "${SANDHOME_REPO_DIR:-}" ]; then
    sh_repo=$SANDHOME_REPO_DIR
elif [ -n "${SH_REPO_DIR:-}" ]; then
    sh_repo=$SH_REPO_DIR
else
    case "$0" in
        */*) sh_repo=$(CDPATH='' cd -- "${0%/*}/.." && pwd) ;;
        *)   sh_repo='' ;;
    esac
    # # STOP: A BARE SHELL FINDS THE CHECKOUT FROM THE ENV FILE, WHICH IS WHERE
    # IT WAS ALREADY WRITTEN. ROUTE.md step 4 offers `eval "$(sandhome env)"`
    # for a shell where sourcing is not possible, and it is the form a tool
    # harness uses: no .profile, no .bashrc, no variables set. The copy PATH
    # names lives on the exec root, where "the parent of $0" is the exec root
    # and there is no lib/ under it, so with no SANDHOME_REPO_DIR in the
    # environment the command could not find its own library and printed
    #   sandhome: no library under /tmp; set SANDHOME_REPO
    # naming a variable documented as the owner/name slug to fetch from a pipe,
    # not a path, so following that error could not work either. The eval was
    # impossible exactly where the docs recommend it (issue #40).
    #
    # The home is not a candidate for the library itself: a network-only install
    # leaves no lib/ under the home, because the library only ever lives in the
    # checkout. What the home does hold is env.sh, and env.sh carries
    # SANDHOME_REPO_DIR. So the same three roots the bootstrap and env.sh
    # resolve are searched for that file, and the single value it records is
    # read the way the shell's own read reads it - the library may not use grep.
    if [ ! -n "$sh_repo" ] || [ ! -r "$sh_repo/lib/common.sh" ]; then
        for sh_repo_home in \
            "${SANDHOME_HOME:-}" \
            "${XDG_DATA_HOME:-}/sandhome" \
            "$HOME/.local/share/sandhome" \
            "$HOME/.sandhome"
        do
            [ -n "$sh_repo_home" ] || continue
            [ -r "$sh_repo_home/env.sh" ] || continue
            while IFS= read -r sh_repo_l; do
                # The line is `export SANDHOME_REPO_DIR=${SANDHOME_REPO_DIR:-'PATH'}`
                # - the leading word, the parameter expansion, and a quoted
                # default all have to come off before what is left is a path.
                # The second pattern is spelled with a leading `*` on purpose.
                # docs/generate-reference.sh takes the first line matching
                # "^ *SANDHOME_REPO_DIR=" as that variable's default value, so a
                # case arm written the obvious way - indented, then the bare
                # name, then `=*` - is read as an assignment and the generated
                # reference reports the default as `*)`. It failed here exactly
                # that way, and a reference that prints `*)` is a document
                # nobody can trust.
                case "$sh_repo_l" in
                    export\ SANDHOME_REPO_DIR=*) sh_repo_l=${sh_repo_l#export } ;;
                esac
                case "$sh_repo_l" in
                    *SANDHOME_REPO_DIR=*)
                        sh_repo=${sh_repo_l#SANDHOME_REPO_DIR=}
                        sh_repo=${sh_repo#\$\{SANDHOME_REPO_DIR:-}
                        sh_repo=${sh_repo%\}}
                        sh_repo=${sh_repo#\'}
                        sh_repo=${sh_repo%\'}
                        sh_repo=${sh_repo#\"}
                        sh_repo=${sh_repo%\"}
                        break ;;
                esac
            done < "$sh_repo_home/env.sh"
            [ -r "$sh_repo/lib/common.sh" ] && break
            sh_repo=''
        done
    fi
    if [ -z "$sh_repo" ] || [ ! -r "$sh_repo/lib/common.sh" ]; then
        printf 'sandhome: cannot find the sandhome library; set SANDHOME_REPO_DIR to the checkout, or run the copy in the checkout\n' >&2
        exit 2
    fi
fi
if [ ! -r "$sh_repo/lib/common.sh" ]; then
    printf 'sandhome: no library under %s; set SANDHOME_REPO_DIR to a checkout containing lib/common.sh\n' "$sh_repo" >&2
    exit 2
fi

SH_REPO_DIR=$sh_repo
SH_LIB_DIR="$sh_repo/lib"
# The env file puts this on PATH, which is what lets a fresh shell run
# `sandhome doctor` by name rather than by path.
SANDHOME_BIN_DIR="$sh_repo/bin"
export SH_REPO_DIR SH_LIB_DIR SANDHOME_BIN_DIR

# shellcheck source=../lib/common.sh
. "$SH_LIB_DIR/common.sh"
# shellcheck source=../lib/detect.sh
. "$SH_LIB_DIR/detect.sh"
# shellcheck source=../lib/space.sh
. "$SH_LIB_DIR/space.sh"
# shellcheck source=../lib/fetch.sh
. "$SH_LIB_DIR/fetch.sh"
# shellcheck source=../lib/env.sh
. "$SH_LIB_DIR/env.sh"
# shellcheck source=../lib/toolchain.sh
. "$SH_LIB_DIR/toolchain.sh"
# shellcheck source=../lib/shim.sh
. "$SH_LIB_DIR/shim.sh"
# shellcheck source=../lib/report.sh
. "$SH_LIB_DIR/report.sh"

sh_detect_all
# # STOP: THE PLAN IS RESOLVED WITHOUT CREATING, AND THE COMMANDS THAT INSTALL
# CREATE. `sh_space_plan` ran unconditionally before the dispatcher and it
# mkdir'd both roots on the way, so `sandhome version` created four directories
# under each of SANDHOME_HOME and SANDHOME_EXEC, and with an unwritable home it
# died at startup with no usage text. A read-only plan answers the same question
# about the machine as it stands; the three commands that put something on disk
# (install, shims, gc) re-plan with creation. tests/space.sh asserts both
# directions, including that `install` still creates.
sh_space_plan --no-create
# The plan owns the values; the exports adopt them when the caller did not
# set them, so every `sh_env_load` below sources fragments that cannot abort
# under `set -u`. See the same binding in bootstrap.sh after its create plan.
: "${SANDHOME_HOME:=$SH_HOME}"
: "${SANDHOME_EXEC:=$SH_EXEC}"
export SANDHOME_HOME SANDHOME_EXEC

usage() {
    cat <<'USAGE'
usage: sandhome COMMAND [args]

  doctor                 probe the environment and report what is missing
  env                    print the environment, for `eval "$(sandhome env)"`
  path                   print the exec-view bin directory
  space [--probe]        where the two roots are, and every candidate tried
  toolchains             name, one-line description, PATH binaries, versions
  install NAME...        adopt or install each toolchain, then write the env
  install --force NAME   install NAME even when a working copy is on PATH
  install rust --target T   add rust cross targets (comma list, repeatable)
  ensure NAME...         alias for install
  repair [NAME...]       rebuild the exec view and launchers, downloading
                         nothing. The fix for "Permission denied" on a tool
                         that is already installed or adopted. No names means
                         every toolchain sandhome knows.
  shims [build]          build the LD_PRELOAD shims this machine needs
  test                   run this checkout's whole test suite
  selftest               the checks that need this machine and no network
  selftest shims         build and exercise the LD_PRELOAD shims
  selftest exec          the noexec-home end-to-end: install, promote, run
  shell [args]           run errandsh, the line discipline with a userspace pty
  pty CMD...             run CMD with a userspace pty (no /dev/ptmx needed)
  exec CMD...            run CMD with the sandhome environment loaded
  report [--json]        the full report
  gc [DAYS] [--dry-run]   remove staging older than DAYS (default 7)
  version                print the schema version
  help                   this text

Environment:
  SANDHOME_HOME   the persistent data root (default $XDG_DATA_HOME/sandhome)
  SANDHOME_EXEC   the exec-capable root; detected when unset
  SANDHOME_REPO   owner/name to fetch when run from a pipe (default
                  talaria0101/sandhome). The checkout that holds lib/ is named
                  by SANDHOME_REPO_DIR, which env.sh sets.
  SANDHOME_SHIMS  set to 1 to put the shims in LD_PRELOAD
  SANDHOME_PASSWD_USERS   extra names for the synthetic passwd database
  SANDHOME_SHA256 a default digest for downloads with no pin of their own.
                  Prefer SANDHOME_SHA256_<NAME> (the toolchain, upper-cased)
                  or SANDHOME_SHA256_<ASSET> (the url's last path segment,
                  upper-cased, no extension, hyphens as underscores), which
                  apply to one download. Resolution order: <NAME>, <ASSET>,
                  a digest the publisher published, then this.
  SANDHOME_REF    branch or tag the pipe bootstrap fetches. Default main
  SANDHOME_REPO_DIR   the checkout the installed copy of this command reads.
                      Set by env.sh; read it, do not set it.
  SANDHOME_MIN_EXEC_MB  free megabytes an exec candidate must have to be
                      preferred. Default 128
  SANDHOME_LOW_EXEC_MB  free megabytes below which the exec root is called low
                      and doctor fails. Default 100
  SANDHOME_CRIT_MB   free megabytes below which the exec root is called
                      critical. Default 32
  SANDHOME_LOW_EXEC_PCT  percent FREE below which a large exec root is low.
                      Default 10
  SANDHOME_PCT_MEANINGFUL_MB  exec root size under which the megabyte rules
                      decide and the percentage is ignored, because 10% of a
                      40MB root is 4MB. Default 1024
  SANDHOME_REQUIRE_DIGEST  1 refuses a download when no sha256 tool exists
  SANDHOME_DOH_URL    DNS-over-HTTPS resolver, e.g. https://1.1.1.1/dns-query.
                      Unset, and the fallback is off until it is set. Used
                      only after curl answers exit 6 twice.
  SANDHOME_GO_VERSION_URL, SANDHOME_GO_DL_JSON_URL, SANDHOME_NODE_INDEX_URL
                      point a version or digest parser at a mirror, so the
                      parsers can be tested offline
  SANDHOME_RUST_TARGETS   comma list of rust cross targets to add on install
                      (same as install rust --target T)
  SANDHOME_ZIG_VERSION    pin the zig release (default latest from index)
  SANDHOME_ZIG_INDEX_URL  point the zig version parser at a mirror for tests
USAGE
}

cmd_env()    { sh_env_print; }
cmd_path()   { printf '%s\n' "$SH_EXEC_BIN"; }
cmd_space() {
    if [ "${1:-}" = --probe ]; then
        sh_space_probe_report
        return 0
    fi
    sh_space_report
}
# cmd_toolchains [--json] -> name, description, declared PATH binaries, the
# status read from a probe, and the version. Everything here is read from the
# machine, not from what the module declares it should be.
cmd_toolchains() {
    if [ "${1:-}" = --json ]; then
        printf '['
        sh_c_n=0
        for sh_c_t in $(sh_toolchain_available); do
            sh_toolchain_load "$sh_c_t" >/dev/null 2>&1
            eval "sh_c_desc=\${TC_${sh_c_t}_DESC:-}"
            eval "sh_c_bins=\${TC_${sh_c_t}_BINS:-}"
            [ "$sh_c_n" -gt 0 ] && printf ','
            printf '{"name":"%s","desc":"%s","bins":"%s","status":"%s","version":"%s"}' \
                "$(sh_json_escape "$sh_c_t")" "$(sh_json_escape "$sh_c_desc")" \
                "$(sh_json_escape "$sh_c_bins")" \
                "$(sh_json_escape "$(sh_toolchain_status "$sh_c_t")")" \
                "$(sh_json_escape "$(sh_toolchain_version "$sh_c_t")")"
            sh_c_n=$((sh_c_n + 1))
        done
        printf ']\n'
        return 0
    fi
    for sh_c_t in $(sh_toolchain_available); do
        sh_toolchain_load "$sh_c_t" >/dev/null 2>&1
        eval "sh_c_desc=\${TC_${sh_c_t}_DESC:-}"
        eval "sh_c_bins=\${TC_${sh_c_t}_BINS:-}"
        if [ -n "$sh_c_bins" ]; then
            sh_c_path="via $(sh_commas_to_spaces "$sh_c_bins")"
        else
            sh_c_path='via its own PATH fragment'
        fi
        printf '%-9s %-8s %-9s %s\n' \
            "$sh_c_t" "$(sh_toolchain_status "$sh_c_t")" \
            "$(sh_toolchain_version "$sh_c_t")" "$sh_c_desc"
        printf '          path: %s\n' "$sh_c_path"
    done
}
cmd_install() {
    if [ "$#" -eq 0 ]; then
        sh_die 'install needs at least one toolchain name'
    fi
    # `install rust --target <triple>,...` adds cross targets via rustup and
    # writes zig-cc linker wrappers on the exec view (see tools/rust.sh and
    # tools/zig.sh). The flag only applies to rust; other toolchains ignore it.
    SH_RUST_TARGETS=''
    sh_c_args=''
    # `install --force NAME` skips the adopt probe and installs NAME into the
    # toolchain root. It exists because the tool PRINTS it: the promote step
    # warns "run 'sandhome install --force <name>' to place it properly" for a
    # borrowed toolchain that cannot run from the exec root, and without the
    # flag the named command adopted again every time and installed nothing
    # (issue #45). An instruction the tool prints must be one the tool obeys.
    SH_FORCE=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --force|-f)
                SH_FORCE=1
                shift ;;
            --force=*)
                case "${1#--force=}" in 0|no|off|false) SH_FORCE=0 ;; *) SH_FORCE=1 ;; esac
                shift ;;
            --target)
                [ "$#" -ge 2 ] || sh_die 'install --target needs a value'
                if [ -n "$SH_RUST_TARGETS" ]; then
                    SH_RUST_TARGETS="$SH_RUST_TARGETS,$2"
                else
                    SH_RUST_TARGETS=$2
                fi
                shift 2 ;;
            --target=*)
                sh_c_v=${1#--target=}
                [ -n "$sh_c_v" ] || sh_die 'install --target needs a value'
                if [ -n "$SH_RUST_TARGETS" ]; then
                    SH_RUST_TARGETS="$SH_RUST_TARGETS,$sh_c_v"
                else
                    SH_RUST_TARGETS=$sh_c_v
                fi
                shift ;;
            *) sh_c_args="$sh_c_args $1"; shift ;;
        esac
    done
    export SH_RUST_TARGETS
    export SH_FORCE
    if [ -z "$(sh_trim "$sh_c_args")" ]; then
        sh_die 'install needs at least one toolchain name'
    fi
    # # STOP: A NAME IS CHECKED BEFORE ANY DOWNLOAD, AND A FAILED ENSURE IS COUNTED.
    # `|| true` made `sandhome install nonsense` print "unknown toolchain" and
    # exit 0, so a script could not tell a typo from a success. sh_fail already
    # increments the counter, so an unknown name and a failed install both end
    # the command non-zero through the check at the bottom of this file.
    for sh_c_n in $sh_c_args; do
        if ! sh_toolchain_known "$sh_c_n"; then
            sh_fail "unknown toolchain $sh_c_n; run 'sandhome toolchains' for the list"
        fi
    done
    sh_env_load
    for sh_c_n in $sh_c_args; do
        sh_toolchain_ensure "$sh_c_n" || true
    done
    sh_env_write
    SH_INSTALLED=$INSTALLED
    SH_ADOPTED=$ADOPTED
    sh_env_load
    return 0
}
# # STOP: REPAIR REBUILDS THE VIEW AND DOWNLOADS NOTHING. Every consumer-facing
# diagnostic procedure routed step 2 through `sandhome install <name>`, and on a
# host with an adopted toolchain that command is the cause of the defect rather
# than the cure for it: it re-runs the adopt path, and 8 rounds of the documented
# procedure left jq, rg or fd broken in 8 of them (issues #49, #43). The repair a
# consumer with "Permission denied" needs is a relink of what is already on the
# machine, and `install` cannot be asked for that without also being allowed to
# download.
#
# So this is the command the docs name, and it does exactly three things: relink
# every toolchain already in the home or already on PATH into the exec view,
# put sandhome and errandsh back on the root, and re-run the shims. It adopts
# nothing, downloads nothing, and so cannot turn a working install into a broken
# one. With no arguments it covers every known toolchain; with names it covers
# only those, which is what a consumer who knows which tool is broken wants.
cmd_repair() {
    sh_env_load
    sh_rp_names=''
    for sh_rp_arg in "$@"; do
        if ! sh_toolchain_known "$sh_rp_arg"; then
            sh_fail "unknown toolchain $sh_rp_arg; run 'sandhome toolchains' for the list"
        fi
        # `sh_in_list` splits on commas and pipes, not on spaces, so a
        # space-separated accumulator would ask it whether ' jq' is in the empty
        # list, be told no, and still be told yes by the first name added. The
        # accumulator is a comma list here for exactly that reason.
        sh_in_list "$sh_rp_arg" "$sh_rp_names" || sh_rp_names="$sh_rp_names,$sh_rp_arg"
    done
    if [ -z "$(sh_trim "$sh_rp_names")" ]; then
        sh_rp_names=$(sh_toolchain_available)
    fi
    for sh_rp_name in $(sh_split_on ',' "$sh_rp_names"); do
        sh_toolchain_known "$sh_rp_name" || continue
        # The module has to be sourced before its TC_<name>_BINS is readable.
        # install gets this for free because sh_toolchain_ensure loads it; a
        # command that goes straight to the promote step has to ask, and asking
        # is what sh_toolchain_load is for.
        sh_toolchain_load "$sh_rp_name" || continue
        eval "sh_rp_bins=\${TC_${sh_rp_name}_BINS:-}"
        [ -n "$sh_rp_bins" ] || continue
        # shellcheck disable=SC2086
        if sh_promote_toolchain "$sh_rp_name" $sh_rp_bins; then
            sh_say "repaired the exec view for $sh_rp_name"
        else
            sh_fail "could not rebuild the exec view for $sh_rp_name"
        fi
    done
    sh_exec_install_launchers
    sh_shim_build_all "$SH_REPO_DIR/shims"
    sh_shim_write_passwd
    sh_shim_report
    sh_env_write
    return 0
}
cmd_shims() {
    if [ "${1:-build}" = build ]; then
        sh_shim_build_all "$SH_REPO_DIR/shims"
        sh_shim_write_passwd
    fi
    sh_shim_report
}
cmd_shell() {
    sh_env_load
    if [ -x "$SH_EXEC_BIN/errandsh" ]; then
        exec "$SH_EXEC_BIN/errandsh" "$@"
    fi
    if [ -r "$SH_REPO_DIR/shell/errandsh" ]; then
        exec sh "$SH_REPO_DIR/shell/errandsh" "$@"
    fi
    sh_die 'no errandsh found'
}
# pty CMD... -> run CMD with a userspace pty, where the kernel has none. The
# wrapper exports the fakepty interposer and execs, so a subshell CMD spawns
# keeps the terminal. This is the same path errandsh uses for a full-screen
# program, exposed for a caller that is not in an errandsh session.
cmd_pty() {
    if [ "$#" -eq 0 ]; then
        sh_die 'pty needs a command'
    fi
    if [ ! -r "$SH_REPO_DIR/shell/faketty" ]; then
        sh_die "no faketty wrapper at $SH_REPO_DIR/shell/faketty"
    fi
    exec sh "$SH_REPO_DIR/shell/faketty" "$@"
}
cmd_exec() {
    if [ "$#" -eq 0 ]; then
        sh_die 'exec needs a command'
    fi
    sh_env_load
    exec "$@"
}
cmd_report() {
    sh_env_load
    if [ "${1:-}" = --json ]; then
        sh_report_json
    else
        sh_report_text
    fi
}
# # STOP: GC VALIDATES ITS ARGUMENT AND MEASURES WHAT IT RECLAIMED. `gc abc` and
# `gc -5` used to print "removed 0 staging entries" and exit 0: the value went
# straight into `find -mtime +"$days"`, find failed, the substitution was empty,
# nothing was removed, and the command reported success. The line now refuses a
# value that is not a whole number of days by name and exits 2, which is what
# `install` already does for an unknown toolchain, and it prints the space
# actually reclaimed rather than a count of entries - the reason to run gc is a
# full exec root, and a count says nothing about bytes. `--dry-run` names what
# it would remove and removes nothing, which a command that deletes should have
# had from the start.
cmd_gc() {
    sh_cg_days=7
    sh_cg_dry=0
    for sh_cg_arg in "$@"; do
        case "$sh_cg_arg" in
            --dry-run) sh_cg_dry=1 ;;
            -*)
                sh_die "gc does not take '$sh_cg_arg'; it takes DAYS, or --dry-run"
                ;;
            *)
                sh_cg_days=$sh_cg_arg
                ;;
        esac
    done
    case "$sh_cg_days" in
        ''|*[!0-9]*)
            sh_die "gc needs a whole number of days, not '$sh_cg_days'"
            ;;
    esac
    sh_cg_before=$(sh_free_kb "$SH_HOME_TMP")
    if [ "$sh_cg_dry" = 1 ]; then
        SH_GC_DRY_RUN=1
        export SH_GC_DRY_RUN
    fi
    sh_cg_removed=$(sh_space_gc "$sh_cg_days") || return $?
    if [ "$sh_cg_dry" = 1 ]; then
        sh_say "dry run: nothing was removed; the entries above are what gc $sh_cg_days would delete"
        return 0
    fi
    sh_cg_after=$(sh_free_kb "$SH_HOME_TMP")
    sh_cg_line="removed $sh_cg_removed staging entries"
    case "$sh_cg_before" in
        ''|*[!0-9]*) ;;
        *)
            case "$sh_cg_after" in
                ''|*[!0-9]*) ;;
                *)
                    sh_cg_kb=$((sh_cg_after - sh_cg_before))
                    [ "$sh_cg_kb" -lt 0 ] && sh_cg_kb=0
                    sh_cg_mb=$((sh_cg_kb / 1024))
                    # # STOP: THE BRACES GO ROUND THE VARIABLE AND NOT ROUND IT
                    # AND THE UNIT. `${x}MB` is `sh_xMB` to the shell, which is a
                    # name nothing ever set, so the line died under `set -u` with
                    # "sh_cg_mbMB: parameter not set" on the very first `gc` a
                    # caller ran. Measured here, on the fix for the argument check
                    # in the same function: a guard that breaks the happy path it
                    # was added to protect.
                    sh_cg_line="$sh_cg_line, ${sh_cg_kb}KB (${sh_cg_mb}MB) reclaimed"
                    ;;
            esac
            ;;
    esac
    sh_say "$sh_cg_line"
    return 0
}
# # NOTE: BOTH PROGRAMS REPORT THE SAME SCHEMA STRING, AND A READER WHO CHECKS
# ONE HAS TO CHECK THE SAME ONE. `bootstrap.sh --version` printed `bootstrap/1`
# and `sandhome version` printed `sandhome/1`: two spellings of the same value,
# so a script that wanted to know whether this tree is schema 1 had to try both
# and could not tell a version difference from a program-name difference. The
# schema is a property of the TREE, not of the file that prints it, and both
# now print `sandhome/1`. The program name still goes in the human line the
# bootstrap prints while setting up, so nothing is lost by the two agreeing.
SH_VERSION_LINE='sandhome/1'
cmd_version() { printf '%s\n' "$SH_VERSION_LINE"; }

# sh_cmd_needs_roots COMMAND -> create both roots, now, for the commands that
# put something on disk. A read-only plan answered first so that the commands
# that only ask could run on a machine whose home cannot be created; this is the
# other half, and it is the ONLY place a root is brought into being by this
# command. An unusable root is refused here, by name, which is what a create
# plan would have done from startup.
sh_cmd_needs_roots() {
    if [ "${SH_PLAN_CREATED:-0}" = 1 ]; then
        return 0
    fi
    sh_space_plan || return 2
    : "${SANDHOME_HOME:=$SH_HOME}"
    : "${SANDHOME_EXEC:=$SH_EXEC}"
    export SANDHOME_HOME SANDHOME_EXEC
    if [ "${SH_EXEC_UNUSABLE:-0}" = 1 ]; then
        if [ -n "${SANDHOME_EXEC:-}" ]; then
            sh_die "SANDHOME_EXEC=$SANDHOME_EXEC is not writable or does not allow exec"
        fi
        sh_die 'no writable mount here both allows exec and can be written; set SANDHOME_EXEC to one'
    fi
    # A create plan may have moved the exec root; make sure the command that was
    # just invoked is on the root it chose (issue #41). `repair` does the same
    # for the same reason: it is the command a consumer runs when the exec view
    # has gone, and the first thing it must put back is the command they are
    # running it with.
    case "${1:-}" in
        install|repair) sh_exec_install_launchers ;;
    esac
    return 0
}

# STOP: `selftest` AND `test` RUN WHAT IS IN THE CHECKOUT, AND WERE NAMED IN THE
# USAGE WITHOUT EXISTING. An agent that reads `sandhome help`, picks the obvious
# subcommand to check a change and gets "unknown command" has been told the tool
# is incomplete. selftest takes no network (syntax, unit, space, shims, and the
# noexec end-to-end when this machine has a noexec root to test with);
# `sandhome test` runs the whole suite the way a caller does.
cmd_selftest() {
    case ${1:-} in
        shims) sandhome_test_one shims ;;
        exec)  sandhome_test_one bootstrap ;;
        # `harness` runs first here too. selftest is what an agent runs under
        # pressure, and a run that reports a broken suite as green is worse than
        # a run that reports nothing; see the note in tests/run.sh.
        *)      sandhome_test_one harness
                 sandhome_test_one syntax
                 sandhome_test_one unit
                 sandhome_test_one space
                 sandhome_test_one shims
                 sandhome_test_one bootstrap
                 sandhome_test_one toolchain ;;
    esac
}

sandhome_test_one() {
    sh_st_file=$SH_REPO_DIR/tests/$1.sh
    if [ ! -r "$sh_st_file" ]; then
        sh_say "no test named $1 in this checkout"
        return 2
    fi
    sh_say "running tests/$1.sh"
    # Through an interpreter, never by executing the file: this checkout may be
    # on a mount that refuses execve, which is the condition the tool exists for.
    sh_st_first=''
    IFS= read -r sh_st_first < "$sh_st_file" 2>/dev/null || sh_st_first=''
    case "$sh_st_first" in
        *bash*) bash "$sh_st_file" ;;
        *)      sh "$sh_st_file" ;;
    esac
}

cmd_test() { sh "$SH_REPO_DIR/tests/run.sh"; }

case "${1:-help}" in
    doctor)      sh_env_load; sh_doctor || exit 1 ;;
    env)         cmd_env ;;
    path)        cmd_path ;;
    space)       shift; cmd_space "$@" ;;
    toolchains)  shift; cmd_toolchains "$@" ;;
    install|ensure) sh_cmd_needs_roots install; shift; cmd_install "$@" ;;
    repair)         sh_cmd_needs_roots repair; shift; cmd_repair "$@" ;;
    shims)       sh_cmd_needs_roots shims; shift; cmd_shims "$@" ;;
    shell)       shift; cmd_shell "$@" ;;
    pty)         shift; cmd_pty "$@" ;;
    exec)        shift; cmd_exec "$@" ;;
    report)      shift; cmd_report "$@" ;;
    gc)          sh_cmd_needs_roots gc; shift; cmd_gc "$@" ;;
    test)        cmd_test ;;
    selftest)    shift; cmd_selftest "${1:-}" ;;
    version|--version) cmd_version ;;
    help|-h|--help) usage ;;
    *)           usage >&2; sh_die "unknown command $1" ;;
esac

if [ "$SH_FAILURES" -gt 0 ]; then
    exit 1
fi
exit 0
