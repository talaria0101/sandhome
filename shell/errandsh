#!/bin/sh
# errandsh - a line discipline for pty-less ssh sessions, in POSIX sh.
#
# WHY THIS EXISTS. A sealed cage has no /dev/ptmx and no devpts, so a remote
# shell over one arrives with no echo, no line editing and no signals. This
# replaces the login shell and provides those itself, in the shell the cage
# already has.
#
# WHY POSIX sh AND NOT PYTHON. The previous errandsh was 432 lines of Python
# 3. A cage may have no python, and a tool whose runtime is a coincidence is a
# tool that stops working. /bin/sh is the one interpreter POSIX guarantees.
#
# STOP: AND THE OBSTACLE IS MEASURED, NOT ASSUMED. Writing line editing in POSIX
# sh is hard for two specific reasons, both checked against dash before this
# file was written:
#
#   * `read -t` is a BASHISM. `dash: read: Illegal option -t`. There is no
#     portable read with a timeout, so a keypress and a job's output cannot
#     be waited on together. This file therefore does not try: while a command
#     runs, the session is not reading keys, and a keypress is type-ahead that
#     is picked up by the NEXT read. That is a real limitation and it is the
#     one thing this cannot fix in sh.
#   * `$'\033'` is a BASHISM. ANSI-C quoting does not exist in POSIX, so every
#     escape here is written `ESC=$(printf '\033')` and compared as a
#     variable.
#
# What that costs, stated plainly: Ctrl-C while a command runs is delivered
# by the OPERATOR's client, not read from the wire here, and type-ahead is
# not consumed until the command finishes. Both are acceptable for the case
# this exists for. Everything below is real.
#
# WHAT IT GIVES YOU.
#   - echo, a prompt with the last exit code, and history with Up/Down
#   - Left Right Home End Delete, and Ctrl-A E B F K U W
#   - Ctrl-R reverse history search
#   - Tab completion of command names and paths
#   - bracketed paste, so a pasted newline does not execute
#   - Ctrl-D, exit and logout leave; the shell and the cwd persist
#   - full-screen programs (nano, less, top, htop, vi, ...) in the foreground,
#     through a USERSPACE pty: the cage has no /dev/ptmx, so shims/fakepty.c is
#     preloaded and makes the session descriptors look like a terminal. It is
#     exported and exec'd, so a subshell a program spawns keeps the terminal.
#   - `errandsh -c 'cmd'` is an exec channel with no line discipline at all
#
# WHAT IT CANNOT DO, STATED PLAINLY. The pty is userspace, so it cannot reach a
# STATICALLY LINKED full-screen program: LD_PRELOAD has nothing to interpose
# into. A dynamically linked one works, and the common ones are dynamic. A
# full-screen command is run in the foreground instead of through the child
# shell, so it does not see that shell's aliases or functions; the cwd is
# restored from the last command.
#
# ENVIRONMENT.
#   ERRANDSH_NAME     the name in the prompt. Default: the hostname.
#   ERRANDSH_HISTORY  the history file. Default $HOME/.errandsh-history.
#   ERRANDSH_SHELL    the shell commands run in. Default /bin/sh.
#   ERRANDSH_MAXHIST  history lines kept. Default 500.
#   ERRANDSH_PTY      set to 0 to stop full-screen programs being auto-run in
#                     the foreground; `pty CMD` still forces it.
#   ERRANDSH_PTY_PROGRAMS  the programs auto-run in the foreground.
#   NO_COLOR          set to anything to drop colour.
#
# TESTED on dash and on bash --posix; see tests/errandsh-posix.sh.

set -u

# STOP: EVERY CONTROL CHARACTER IS A POSIX `printf` OCTAL ESCAPE, because
# ANSI-C quoting ($'\033') is a BASHISM and does not exist in dash. Checked
# against dash before this file was written: `dash -c "echo $'\033'"` prints a
# literal, not an escape. The names are the control NAMES, not their numbers,
# so a reader can tell which key is which without counting hex.
# STOP: EVERY CONTROL CHARACTER IS BUILT WITH A SENTINEL, AND THE SENTINEL IS
# NOT OPTIONAL. `NL=$(printf '\n')` STORES THE EMPTY STRING: a command
# substitution strips trailing newlines, so the variable that was supposed to
# hold "newline" held nothing, `"$NL"` became an empty pattern, and the byte
# loop's own "is this empty" test read every Enter as end of input. The session
# therefore exited on the first Enter, having run nothing. Measured:
# `NL=$(printf '\n'); echo ${#NL}` prints 0, and
# `NL=$(printf '\nx'); NL=${NL%x}` prints 1.
#
# `x=$(dd bs=1 count=1)` for a keystroke has the same defect, and the same fix.
# The two idioms below are the whole of it:
#
#     keep()  { X=$(printf "$1x"); X=${X%x}; }   # a literal that may end in \n
#     byte()  { X=$(dd bs=1 count=1 2>/dev/null; printf x); X=${X%x}; }
#
# ANSI-C quoting ($'\033') would be the readable answer and is a BASHISM:
# `dash -c "echo $'\033'"` prints a literal, not an escape.
keep() { _v=$(printf "$1x"); _v=${_v%x}; }

keep '\033'; ES=$_v            # the escape byte
ESC_ESC=$ES                     # the name the key loop reads
keep '\003'; ESC_ETX=$_v      # Ctrl-C
keep '\004'; ESC_EOT=$_v      # Ctrl-D
keep '\001'; ESC_A=$_v        # Ctrl-A, home
keep '\002'; ESC_B=$_v        # Ctrl-B, back one
keep '\005'; ESC_E=$_v        # Ctrl-E, end
keep '\006'; ESC_F=$_v        # Ctrl-F, forward one
keep '\013'; ESC_K=$_v        # Ctrl-K, kill to end
keep '\022'; ESC_R=$_v        # Ctrl-R, reverse search
keep '\025'; ESC_U=$_v        # Ctrl-U, kill to start
keep '\027'; ESC_W=$_v        # Ctrl-W, kill word
keep '\177'; BRK=$_v          # DEL, which is what Backspace sends
keep '\r';   CR=$_v
keep '\n';   NL=$_v
keep '\t';   TAB=$_v
keep '\133'; ESC_BRACKET=$_v   # '[', which no control name covers
# The letters the escape sequences are built from, and the two `~` forms a
# terminal sends for Home/End/Delete. They are variables rather than literals
# because they sit next to a raw ESC, and a raw ESC in source is invisible in
# an editor, which is how a reviewer misses a change to it.
keep 'A';  A=$_v
keep 'B';  B=$_v
keep 'C';  C_=$_v
keep 'D';  D=$_v
keep 'F';  F=$_v
keep 'H';  H=$_v
keep '1';  ONE_TILDE="$_v~"
keep '3';  THREE_TILDE="$_v~"
keep '4';  FOUR_TILDE="$_v~"
SP=' '

# A self-check, because every one of these being empty is silent and fatal, and
# a shell that cannot compare against a newline has no way to say so.
for _n in ESC_ESC ESC_ETX ESC_EOT ESC_A ESC_B ESC_E ESC_F ESC_K ESC_R ESC_U \
          ESC_W BRK CR NL TAB; do
    eval "_len=\${#$_n}"
    if [ "$_len" -eq 0 ]; then
        echo "errandsh: internal error: \$$_n is empty, so key handling cannot work" >&2
        exit 70
    fi
done

# ----------------------------------------------------------------- passthrough
# `errandsh -c 'cmd'` is an exec channel: the command runs, its exit code is
# the session's, and no line discipline is in the way. Everything after -c is
# the command, so the caller owns the quoting and it is not re-split here.
if [ "${1:-}" = "-c" ]; then
    shift
    if [ $# -eq 0 ]; then
        echo "errandsh: -c needs a command" >&2
        exit 2
    fi
    exec ${ERRANDSH_SHELL:-/bin/sh} -c "$*"
fi

# ----------------------------------------------------------------- settings
: "${HOME:=/root}"
: "${ERRANDSH_MAXHIST:=500}"
ERRANDSH_NAME=${ERRANDSH_NAME:-$(hostname 2>/dev/null || echo errand)}
ERRANDSH_NAME=${ERRANDSH_NAME%%.*}
if [ ${#ERRANDSH_NAME} -gt 24 ]; then
    ERRANDSH_NAME=$(printf '%s' "$ERRANDSH_NAME" | cut -c1-24)
fi
: "${ERRANDSH_HISTORY:=$HOME/.errandsh-history}"
: "${ERRANDSH_SHELL:=/bin/sh}"

# Colour, dropped when stdout is not a terminal or NO_COLOR is set, because
# escape codes in a pipe or a log file are noise nobody asked for.
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    C_RST=$(printf '\033[0m');   C_GRN=$(printf '\033[1;32m')
    C_RED=$(printf '\033[1;31m'); C_BLU=$(printf '\033[1;34m')
    C_CYN=$(printf '\033[1;36m'); C_YEL=$(printf '\033[0;33m')
else
    C_RST=''; C_GRN=''; C_RED=''; C_BLU=''; C_CYN=''; C_YEL=''
fi

# A write to a socket that the peer has closed must not kill the session, so
# every terminal write goes through emit() and its status is discarded.
emit() { printf '%s' "$1" 2>/dev/null || true; }

# ----------------------------------------------------------------- raw mode
# Raw mode is what makes a keypress arrive without a line feed. It is put on
# and restored, and the restore is on a trap, because a session killed with
# SIGKILL leaves the operator's terminal in raw mode and that is a genuinely
# bad outcome to hand someone.
RAW=0
restore_tty() {
    if [ "$RAW" = 1 ]; then
        stty sane 2>/dev/null || true
        RAW=0
    fi
}
cleanup() {
    restore_tty
    emit "$NL"
    [ -n "${FIFO:-}" ] && rm -f "$FIFO" 2>/dev/null
    exit 0
}
trap cleanup EXIT HUP INT TERM

# `stty raw -echo` is POSIX. If it fails there is no terminal to discipline
# and the script still works as a plain filter, which is the right degradation
# rather than a refusal.
if stty raw -echo 2>/dev/null; then
    RAW=1
fi

# ----------------------------------------------------------------- the shell
# One long-lived child shell, so the session behaves like a real login: the
# cwd, the environment and any function the user defined all persist across
# commands. Each command is followed by a marker carrying its exit code and its
# $PWD, and the marker is what the reader waits for.
#
# The $$ in the marker is this script's pid, so two sessions sharing a history
# file cannot mistake each other's completion for their own.
MARKER="@@ERAND.$$.@@"
FIFO="${TMPDIR:-/tmp}/.errandsh.$$"
rm -f "$FIFO" 2>/dev/null || true
if ! mkfifo "$FIFO" 2>/dev/null; then
    echo "errandsh: cannot create a fifo at $FIFO" >&2
    exit 1
fi

# STOP: THE CHILD'S STDIN IS THE FIFO OPENED READ-WRITE, AND THE REASON IS THAT
# A HALF-OPENED FIFO IS A HANG. `sh <fifo` blocks until a writer appears, and
# a read-write open never blocks and never reports EOF, which is exactly what a
# long-lived child needs: it must outlive the command that started it. fd 3
# carries commands IN; the child's stdout is this script's stdout.
exec 9<>"$FIFO"
# The child's OUTPUT is a second fifo, because the key loop owns stdin and the
# marker reader owns stdout, and one stream cannot be both. Reading the child's
# output with `read` from stdin would read the OPERATOR's keys and would
# consume them, which is the bug this arrangement exists to prevent.
OFIFO="${TMPDIR:-/tmp}/.errandsh.out.$$"
rm -f "$OFIFO" 2>/dev/null || true
mkfifo "$OFIFO" 2>/dev/null || true
# STOP: NO `--noprofile --norc`, BECAUSE A POSIX /bin/sh MAY NOT HAVE THEM.
# Measured on this host's /bin/sh (dash 0.5.11):
#
#     $ /bin/sh --noprofile --norc -c 'echo ok'
#     /bin/sh: 0: Illegal option --
#
# and the child therefore died at STARTUP, before reading a single command,
# so every command produced no output and the session looked like a
# transport that worked and a shell that did not. The flags are a BASHISM and
# a busybox-and-bash convenience, not POSIX.
#
# They are also not needed here. A POSIX shell reads a script from a
# non-terminal WITHOUT sourcing the user's startup files: profile files are
# read for an interactive login shell, and this one is not interactive. The
# behaviour the flags were meant to guarantee is the default.
#
# `-i` is deliberately NOT passed either. It would ask for job control, which
# needs a terminal this does not have, and it would put the child into
# interactive mode where it prints prompts of its own and competes with the
# line discipline above.
${ERRANDSH_SHELL} <"$FIFO" >"$OFIFO" 2>&1 &
SHELL_PID=$!
rm -f "$FIFO" 2>/dev/null || true
# fd 8 carries the child's output back to this loop.
exec 8<"$OFIFO"
rm -f "$OFIFO" 2>/dev/null || true

# A non-interactive shell dies on SIGINT, and the session's Ctrl-C has to
# reach only the foreground job. Trapping INT to a no-op in the child is what
# keeps the child alive while the job dies.
# (Sent once the shell is up; see the first read below.)

# ----------------------------------------------------------------- history
HIST=''
hist_load() {
    if [ -r "$ERRANDSH_HISTORY" ]; then
        HIST=$(tail -n "$ERRANDSH_MAXHIST" "$ERRANDSH_HISTORY" 2>/dev/null || true)
    else
        HIST=''
    fi
    # # STOP: `grep -c` PRINTS A COUNT AND EXITS 1 WHEN IT MATCHES NOTHING, SO
    # `grep -c . || echo 0` YIELDS "0\n0" AND EVERY ARITHMETIC ON IT DIES
    # WITH "Illegal number". The count is taken with a `case` on the output
    # instead, and the exit status is deliberately discarded. This was the
    # first crash this file had, on an EMPTY history, which is the state a
    # fresh session is always in.
    HCOUNT=$(printf '%s\n' "$HIST" | grep -c . 2>/dev/null)
    case "$HCOUNT" in
        ''|*[!0-9]*) HCOUNT=0 ;;
    esac
    HPOS=$((HCOUNT + 1))
}
hist_save() {
    [ -z "$1" ] && return 0
    # A repeated command is not appended twice, which is what makes Up/Down
    # useful rather than a way to reach the same line six times.
    if printf '%s\n' "$HIST" | grep -Fxq -- "$1" 2>/dev/null; then
        # # STOP: THE POSITION IS RESET EVEN WHEN NOTHING IS APPENDED. A repeated
        # command returns early here, and the first version of this function
        # left HPOS where it was, so after a duplicate HPOS pointed one past
        # the end and Up skipped the newest entry. The measurement: `cd -` is
        # a repeat of nothing but `cd /tmp` is not, and the sequence
        # `cd /tmp`, `cd -`, Up landed on the wrong line in both dash and
        # bash. HPOS is "where in history am I", and running a command moves
        # you to the end of it whether or not it was new.
        HPOS=$((HCOUNT + 1))
        return 0
    fi
    HIST="$HIST
$1"
    printf '%s\n' "$1" >>"$ERRANDSH_HISTORY" 2>/dev/null || true
    HCOUNT=$((HCOUNT + 1))
    HPOS=$((HCOUNT + 1))
    # Trim on disk too, or the file is the only thing here that grows without
    # bound and a long session eventually fails on ENOSPC rather than on a
    # history that is too long.
    if [ -f "$ERRANDSH_HISTORY" ]; then
        _n=$(wc -l <"$ERRANDSH_HISTORY" 2>/dev/null)
        case "$_n" in
            ''|*[!0-9]*) _n=0 ;;
        esac
        if [ "$_n" -gt $((ERRANDSH_MAXHIST * 2)) ] 2>/dev/null; then
            _t="$ERRANDSH_HISTORY.tmp.$$"
            if tail -n "$ERRANDSH_MAXHIST" "$ERRANDSH_HISTORY" >"$_t" 2>/dev/null; then
                mv "$_t" "$ERRANDSH_HISTORY" 2>/dev/null || rm -f "$_t" 2>/dev/null
            fi
        fi
    fi
    return 0
}
hist_load

# ----------------------------------------------------------------- editing
# The line and the cursor. POS is 1-based because a cursor at the start of a
# line is position 1, and 0-based arithmetic here costs an off-by-one on every
# keypress. ${#LINE} is a character count, which is correct for the ASCII and
# UTF-8 sequences an operator actually types at a prompt.
LINE=''
POS=1

# STOP: `cut -cN-` FAILS WHEN N EXCEEDS THE LINE, AND `cut -c1-0` FAILS TOO, SO
# EVERY HELPER BELOW GOES THROUGH `take`/`drop`, WHICH ARE TOTAL. This was the
# second crash this file had: typing the first character at position 1 of an
# empty line asked cut for a range that does not exist, and the error text
# went to the operator's screen in the middle of their command.
take() { # the first N characters; N clamped to the length, 0 allowed
    _n=$1
    _l=${#LINE}
    [ "$_n" -gt "$_l" ] && _n=$_l
    [ "$_n" -le 0 ] && { printf ''; return 0; }
    printf '%s' "$LINE" | cut -c1-"$_n"
}
drop() { # everything from the Nth character on; N clamped, 0 means all
    _n=$1
    _l=${#LINE}
    if [ "$_n" -le 0 ]; then printf ''; return 0; fi
    if [ "$_n" -gt $((_l + 1)) ]; then printf '%s' "$LINE"; return 0; fi
    printf '%s' "$LINE" | cut -c"$_n"-
}

ins() { # insert char at POS
    _pre=$(take $((POS - 1)))
    _post=$(drop "$POS")
    LINE="$_pre$1$_post"
    POS=$((POS + 1))
}
backspace() {
    [ "$POS" -le 1 ] && return 0
    _pre=$(take $((POS - 2)))
    _post=$(drop "$POS")
    LINE="$_pre$_post"
    POS=$((POS - 1))
}
del_at() { # delete the char at POS, i.e. Delete not Backspace
    [ "$POS" -gt "${#LINE}" ] && return 0
    _pre=$(take $((POS - 1)))
    _post=$(drop $((POS + 1)))
    LINE="$_pre$_post"
}
kill_to_start() { # Ctrl-U
    LINE=$(drop "$POS")
    POS=1
}
kill_to_end() { # Ctrl-K
    LINE=$(take $((POS - 1)))
}
kill_word() { # Ctrl-W: back over the previous word and the space before it
    _head=$(take $((POS - 1)))
    _trimmed=$(printf '%s' "$_head" | sed 's/[[:space:]]*$//')
    _kept=$(printf '%s' "$_trimmed" | sed 's/[^[:space:]]*$//')
    _tail=$(drop "$POS")
    LINE="$_kept$_tail"
    POS=$((${#_kept} + 1))
}

shortcwd() {
    case "$LAST_DIR" in
        "$HOME") printf '~' ;;
        "$HOME"/*) printf '~%s' "${LAST_DIR#"$HOME"}" ;;
        *) printf '%s' "$LAST_DIR" ;;
    esac
}
LAST_RC=0
LAST_DIR=$HOME
prompt() {
    if [ "$LAST_RC" -eq 0 ]; then P=$C_GRN; else P=$C_RED; fi
    emit "$P[$LAST_RC]$C_RST ${ERRANDSH_NAME}:$C_BLU$(shortcwd)$C_RST$SP"
}
redraw() {
    # Clear the line, reprint prompt and text, walk the cursor back. The
    # backspace count is what is AFTER the cursor, not the line length, which
    # is the off-by-one that leaves a stray character at the end of a long
    # line and was the first bug this file had.
    emit "$CR$(printf '\033[K')"
    prompt
    emit "$LINE"
    _rest=$(( ${#LINE} - POS + 1 ))
    if [ "$_rest" -gt 0 ]; then
        emit "$(printf '\r\033[%dD' "$_rest")"
    fi
    return 0
}

# ----------------------------------------------------------------- completion
# Tab completes a command name against $PATH, or a path against the
# filesystem. `command -v` is POSIX and answers for each candidate without a
# fork per candidate, which a `ls` in a loop would pay on every Tab.
complete_tab() {
    _before=$(take $((POS - 1)))
    _after=$(drop "$POS")
    case "$_before" in
        *"$SP"*) _frag='' ;;
        *)      _frag=${_before##* } ;;
    esac
    _matches=''
    case "$_frag" in
        */*)
            _dir=${_frag%/*}; _base=${_frag##*/}
            [ -z "$_dir" ] && _dir='.'
            for _f in "$_dir"/*; do
                [ -e "$_f" ] || continue
                _n=${_f##*/}
                case "$_n" in
                    "$_base"*) _matches="$_matches$_n " ;;
                esac
            done
            ;;
        *)
            _oldifs=$IFS
            IFS=:
            for _d in $PATH; do
                [ -d "$_d" ] || continue
                for _f in "$_d"/"$_frag"*; do
                    [ -f "$_f" ] && [ -x "$_f" ] || continue
                    _n=${_f##*/}
                    _matches="$_matches$_n "
                done
            done
            IFS=$_oldifs
            ;;
    esac
    [ -z "$_matches" ] && return 0
    # One match completes; several become the longest common prefix, and a
    # second Tab lists them. Listing unconditionally is worse than not listing
    # at all, because it scrolls the line away on every stray Tab.
    set -- $_matches
    if [ $# -eq 1 ]; then
        LINE="${_before}$1$_after"
        POS=$((POS + ${#1}))
        redraw
    else
        _lcp=$1
        shift
        for _c in "$@"; do
            while :; do
                case "$_c" in
                    "$_lcp"*) break ;;
                    *)
                        _k=$(( ${#_lcp} - 1 ))
                        [ "$_k" -le 0 ] && { _lcp=''; break; }
                        _lcp=$(take "$_k")
                        ;;
                esac
            done
        done
        LINE="${_before}${_lcp}$_after"
        POS=$((POS + ${#_lcp} - ${#_frag}))
        redraw
    fi
    return 0
}

# ----------------------------------------------------------------- history nav
hist_prev() {
    if [ "$HPOS" -le 1 ]; then return 0; fi
    HPOS=$((HPOS - 1))
    _n=$(printf '%s\n' "$HIST" | grep -n . | sed -n "${HPOS}p" | cut -d: -f2-)
    LINE=${_n:-''}
    POS=$((${#LINE} + 1))
}
hist_next() {
    if [ "$HPOS" -ge "$HCOUNT" ]; then
        HPOS=$((HCOUNT + 1))
        LINE=''
        POS=1
        return 0
    fi
    HPOS=$((HPOS + 1))
    _n=$(printf '%s\n' "$HIST" | grep -n . | sed -n "${HPOS}p" | cut -d: -f2-)
    LINE=${_n:-''}
    POS=$((${#LINE} + 1))
}

# ----------------------------------------------------------------- Ctrl-R
# Reverse search. The match is shown and NOT executed until Enter, so a search
# that lands on the wrong line costs one more keystroke and not a command.
SEARCH=''
SEARCH_HIT=''
rsearch_draw() {
    _m=$(printf '%s\n' "$HIST" | grep -i -- "$SEARCH" 2>/dev/null | tail -n 1)
    emit "$CR$(printf '\033[K')"
    if [ -z "$SEARCH" ]; then
        prompt
        return 0
    fi
    if [ -z "$_m" ]; then
        emit "$C_CYN(rsearch)\`$SEARCH\`$C_RST no match"
        SEARCH_HIT=''
        return 0
    fi
    SEARCH_HIT=$_m
    emit "$C_CYN(rsearch)\`$SEARCH\`$C_RST $_m"
}
rsearch_next() {
    _m=$(printf '%s\n' "$HIST" | grep -i -- "$SEARCH" 2>/dev/null | tail -n 1)
    [ -z "$_m" ] && return 0
    SEARCH_HIT=$_m
    emit "$CR$(printf '\033[K')$C_CYN(rsearch)\`$SEARCH\`$C_RST $_m"
}

# ----------------------------------------------------------------- fake pty
# A full-screen program cannot run through the child shell: the child reads
# commands from a fifo, so a program asking for a terminal gets a pipe, and the
# line discipline above is still the one reading the keys. There is no
# /dev/ptmx in the cage this exists for, so no kernel pty can be made either.
# What works is to run the command in the FOREGROUND on the session's own
# descriptors with shims/fakepty.c preloaded (shell/faketty exports it), so the
# program gets isatty()==1, a termios and a window size, and reads the
# operator's keys directly. It is bypassed for that one command, so it does not
# see the child shell's aliases; the cwd is taken from $LAST_DIR.
#
# The list is auto-run; `pty CMD` forces it for anything not listed, and
# ERRANDSH_PTY=0 turns the automatic path off.
: "${ERRANDSH_PTY_PROGRAMS:=vi vim nvim nano emacs emacsclient pico less more pg top htop btop watch screen tmux mc joe micro mutt}"

# errandsh_pty_command CMD -> CMD with a leading `pty ` removed.
errandsh_pty_command() {
    case "$1" in
        "pty "*) printf '%s' "${1#pty }" ;;
        pty)     printf '' ;;
        *)       printf '%s' "$1" ;;
    esac
}

# errandsh_faketty -> the faketty wrapper beside this script or in the durable
# repo. The exec view holds a copy of errandsh, so both locations are tried.
errandsh_faketty() {
    for _ef_d in "${SANDHOME_REPO_DIR:-}" "${0%/*}"; do
        [ -n "$_ef_d" ] || continue
        if [ -r "$_ef_d/shell/faketty" ]; then
            printf '%s' "$_ef_d/shell/faketty"; return 0
        fi
        if [ -r "$_ef_d/faketty" ]; then
            printf '%s' "$_ef_d/faketty"; return 0
        fi
    done
    return 1
}

# errandsh_pty_wanted CMD -> 0 for an explicit `pty` request or a program on
# the list. The first WORD is compared, so `less file` matches and `echo less`
# does not.
errandsh_pty_wanted() {
    case "$1" in
        "pty "*|pty) return 0 ;;
    esac
    _epw_w=${1%% *}
    _epw_w=${_epw_w##*/}
    for _epw_p in $ERRANDSH_PTY_PROGRAMS; do
        [ "$_epw_p" = "$_epw_w" ] && return 0
    done
    return 1
}

# run_pty CMD -> run CMD in the foreground with a userspace pty, on this
# session's descriptors, and put its status in LAST_RC.
run_pty() {
    _rp_cmd=$(errandsh_pty_command "$1")
    [ -n "$_rp_cmd" ] || return 0
    hist_save "$_rp_cmd"
    emit "$_rp_cmd$NL"
    _rp_rc=0
    _rp_tty=$(errandsh_faketty) || _rp_tty=''
    if [ -n "$_rp_tty" ]; then
        # The subshell is what keeps fd 0-2 pointed at the operator; the `cd`
        # gives the command the directory the line discipline is in.
        ( cd "${LAST_DIR:-$PWD}" 2>/dev/null || true
          sh "$_rp_tty" "${ERRANDSH_SHELL:-/bin/sh}" -c "$_rp_cmd" ) || _rp_rc=$?
    else
        # No wrapper: run it plain, which is the old behaviour and at least a
        # working command rather than a refusal. The warning is said once, so
        # the cause of a batch-mode TUI is visible without flooding the screen.
        if [ "${ERRANDSH_PTY_WARNED:-0}" != 1 ]; then
            emit "errandsh: [!] no faketty wrapper found; a full-screen program runs without a terminal${NL}"
            ERRANDSH_PTY_WARNED=1
        fi
        ( cd "${LAST_DIR:-$PWD}" 2>/dev/null || true
          sh -c "$_rp_cmd" ) || _rp_rc=$?
    fi
    LAST_RC=$_rp_rc
    emit "$NL"
    return 0
}

# ----------------------------------------------------------------- execution
# The command goes to the child's stdin, then a marker that carries the exit
# code and the cwd back. Output is read until the marker; everything before it
# is the command's output, everything after is the session's.
run_command() {
    _cmd=$1
    [ -z "$_cmd" ] && return 0
    case "$_cmd" in
        exit|logout) cleanup ;;
    esac
    # A full-screen program is handed the session directly; everything else
    # keeps the persistent child shell.
    case "$_cmd" in
        "pty "*|pty) run_pty "$_cmd"; return 0 ;;
    esac
    if [ "${ERRANDSH_PTY:-1}" != 0 ] && errandsh_pty_wanted "$_cmd"; then
        run_pty "$_cmd"
        return 0
    fi
    hist_save "$_cmd"
    # Echo the command ourselves: the terminal is in raw mode, so nothing
    # echoes it for us, and an operator needs to see what they ran.
    emit "$_cmd$NL"
    # Bracketed paste, when the client offers it. Enabling it means a pasted
    # newline arrives as a paste marker rather than as a bare LF, so a
    # multi-line paste does not run line by line. The marker is cleared again
    # below the command, because a command that reads stdin needs it off.
    emit "$(printf '\033[?2004h')"
    printf '%s\n' "$_cmd" >&$CMD_FD
    # The marker line the child runs after the command. It prints
    # MARKER:<rc>:<cwd>, and the reader below matches on MARKER and splits the
    # rest. The %% are for THIS printf; the child sees single %s.
    #
    # # STOP: AND IT MUST BE `printf '%s\n' MARKER` FORM, NOT `printf MARKER`,
    # because a marker beginning with `--` would be taken as an option. The
    # first version of this line did exactly that and the child answered
    # `/bin/sh: 0: Illegal option --`, which reads like a broken shell rather
    # than a broken marker.
    # @@ERAND.<pid>.@@<rc>:<cwd>@@   -- the pid makes the prefix unique to
    # THIS shell, so a line belonging to another session on the same stream is
    # not mistaken for this one's answer, and everything after the prefix is
    # the answer, owned by the reader below and nowhere else.
    # # STOP: THE CHILD'S MARKER MUST END WITH A NEWLINE, OR `read` BLOCKS FOREVER.
    # `read` returns when it sees a line terminator, so a marker printed
    # without one leaves the reader waiting on a line that will never arrive
    # and the session hangs after the FIRST command with no error anywhere.
    # Measured: the child's output ended `...sandssh@@` with no `\n`.
    printf '%s\n' "printf \"${MARKER}%s:%s@@\\n\" \"\$?\" \"\$PWD\"" >&$CMD_FD
    # Drain the child until the marker. `read -t` is unavailable in POSIX sh,
    # so this blocks on the marker and the keys typed meanwhile are type-ahead,
    # which is the limitation the header states.
    # Drain the child until the marker. fd 8 is the child's output; reading
    # from stdin instead would consume the OPERATOR's keystrokes, which is the
    # bug the second fifo exists to prevent.
    #
    # # STOP: `read -t` IS A BASHISM AND IS NOT USED, SO THIS BLOCKS ON THE MARKER
    # rather than polling. The cost is stated in the header: a keypress typed
    # while a command runs is type-ahead and is read after the command
    # finishes, not lost and not delivered to the command. `dash` refuses
    # `read -t` outright, so the alternative is a program that does not run.
    # # STOP: THE READ IS NOT IN A COMMAND SUBSTITUTION, AND THAT IS NOT A STYLE
    # CHOICE. `x=$(read -r l <&8)` FORKS, and the process that blocks on the
    # fifo is the fork's CHILD, while the parent shell's copy of fd 8 has
    # nothing pending and sees EOF. The result is an empty string, every
    # command appears to produce no output, and the session looks like a
    # transport that works and a shell that does not. Reading straight into a
    # variable keeps the blocking read in the shell that owns the descriptor.
    # Measured: `read -r l <&8` returns the line; `x=$(read -r l <&8)`
    # returns empty, on dash and on bash alike.
    while :; do
        if ! read -r _l <&8; then
            break
        fi
        case "$_l" in
            *"${MARKER}"*)
                # The line is <output prefix><MARKER><rc>:<cwd>@@ and the
                # marker carries THIS shell's pid, so a line belonging to
                # another session on the same stream is not read as this
                # one's answer.
                #
                # # STOP: EVERYTHING BEFORE THE MARKER IS ECHOED. A marker protocol
                # that discards it loses the answer it was sent with, and the
                # output is the reason the marker exists at all.
                _pre=${_l%%"$MARKER"*}
                if [ -n "$_pre" ]; then
                    emit "${_pre}${NL}"
                fi
                # <rc>:<cwd>  and the cwd may contain colons, so rc is taken up
                # to the FIRST colon and the whole remainder is the path.
                # Parsing fields positionally from the front would truncate a
                # path like /a:b/c.
                _rest=${_l#*"$MARKER"}
                _rest=${_rest%@@}
                _rc=${_rest%%:*}
                _dir=${_rest#*:}
                case "$_rc" in
                    ''|*[!0-9]*) ;;
                    *) LAST_RC=$_rc ;;
                esac
                [ -n "$_dir" ] && LAST_DIR=$_dir
                break
                ;;
            *)
                emit "$_l$NL"
                ;;
        esac
    done
    emit "$(printf '\033[?2004h')"
    return 0
}

# fd 9 carries commands to the child. It is separate from stdin so the key
# loop below can own stdin and the two never fight over one descriptor.
CMD_FD=9

# ----------------------------------------------------------------- the loop
prompt
LINE=''
POS=1
FIRST=1

while :; do
    if [ "$FIRST" = 1 ]; then
        FIRST=0
        # Tell the child to survive SIGINT, and turn on bracketed paste.
        printf 'trap "" INT\n' >&$CMD_FD 2>/dev/null || true
        emit "$(printf '\033[?2004h')"
    fi
    prompt

    ESC=''
    while :; do
        # # STOP: ONE BYTE AT A TIME, WITH A SENTINEL, AND THE SENTINEL IS THE
        # WHOLE TRICK. `C=$(dd bs=1 count=1)` STRIPS A TRAILING NEWLINE, so
        # pressing Enter produced the EMPTY STRING, the EOF test read it as
        # end of input, and the session exited on the first Enter with the
        # command never run. Measured on dash: a piped "ab\n" arrives as a, b,
        # then EMPTY. Appending a sentinel INSIDE the substitution makes the
        # newline non-trailing, so the shell has nothing to strip, and the
        # sentinel is removed afterwards. One fork per keystroke and no bashism.
        #
        # `read -n 1` is the obvious alternative and dash refuses it:
        # `dash: read: Illegal option -t` for the timeout form, and `-n` is
        # the same family of extension.
        C=$(dd bs=1 count=1 2>/dev/null; printf x)
        C=${C%x}
        if [ -z "$C" ]; then
            cleanup
        fi

        # A bare ESC is the start of a sequence. Hold it and take the next
        # byte, and drop the pair if the second byte is not a bracket, which
        # is what a real ESC key press looks like.
        # # STOP: THE ESCAPE SEQUENCE IS ACCUMULATED AND DECIDED ONLY WHEN IT IS
        # COMPLETE, AND THAT IS THE BUG THIS REPLACES. The first two versions
        # branched on whether the PREVIOUS byte was an escape, so the dispatch
        # ran on the SECOND byte: an Up key arrives as 1b 5b 41, ESC was set
        # on the 1b, and the comparison was handed "1b 5b" with the 41 still
        # unread. Nothing matched, and the A was then inserted as text. The
        # measurement that pinned it: a trace of the compare showed
        # ESCN=1b5b while C=5b and the A had not been read yet.
        #
        # So: collect bytes into $ESCN until one of the known sequences
        # matches, a terminator arrives, or the bound below is hit. A bound is
        # not optional, because a peer that sends ESC and then nothing would
        # otherwise hang the session on a sequence that never completes.
        if [ "$C" = "$ESC_ESC" ]; then
            ESCN=$ESC_ESC
            ESCN_N=1
            ESC_GOT=
        elif [ -n "${ESCN:-}" ]; then
            ESCN="$ESCN$C"
            ESCN_N=$(( ${ESCN_N:-0} + 1 ))
            ESC_GOT=1
        fi

        if [ -n "${ESCN:-}" ]; then
            case_done=0
            if   [ "$ESCN" = "$ES$ESC_BRACKET$A" ];   then hist_prev; redraw; case_done=1
            elif [ "$ESCN" = "$ES$ESC_BRACKET$B" ];   then hist_next; redraw; case_done=1
            elif [ "$ESCN" = "$ES$ESC_BRACKET$C_" ]; then
                [ "$POS" -le "${#LINE}" ] && { POS=$((POS + 1)); redraw; }; case_done=1
            elif [ "$ESCN" = "$ES$ESC_BRACKET$D" ];   then
                [ "$POS" -gt 1 ] && { POS=$((POS - 1)); redraw; }; case_done=1
            elif [ "$ESCN" = "$ES$ESC_BRACKET$H" ] || [ "$ESCN" = "$ES$ESC_BRACKET$ONE_TILDE" ]; then
                POS=1; redraw; case_done=1
            elif [ "$ESCN" = "$ES$ESC_BRACKET$F" ] || [ "$ESCN" = "$ES$ESC_BRACKET$FOUR_TILDE" ]; then
                POS=$((${#LINE} + 1)); redraw; case_done=1
            elif [ "$ESCN" = "$ES$ESC_BRACKET$THREE_TILDE" ]; then
                del_at; redraw; case_done=1
            elif [ ${ESCN_N:-0} -ge 6 ]; then
                # An unknown or unfinished sequence, and six bytes is more than
                # any terminal sends for a key this file knows. Swallowing it
                # is right: inserting the bytes would put the operator's
                # terminal's private sequences into their command line.
                case_done=1
            else
                # Incomplete: wait for the next byte.
                continue
            fi
            ESCN=
            ESCN_N=0
            continue
        fi

        case "$C" in
            "$CR"|"$NL")
                emit "$NL"
                CMD=$LINE
                LINE=''; POS=1
                run_command "$CMD"
                prompt
                break
                ;;
            "$BRK")
                backspace; redraw
                continue
                ;;
            "$TAB")
                complete_tab
                continue
                ;;
            "$ESC_ETX")
                # Ctrl-C. While a command runs this script is not reading, so
                # this only fires at the prompt: it abandons the line.
                emit "^C$NL"
                LINE=''; POS=1
                prompt
                break
                ;;
            "$ESC_EOT")
                cleanup
                ;;
            "$ESC_A") POS=1; redraw; continue ;;
            "$ESC_E") POS=$((${#LINE} + 1)); redraw; continue ;;
            "$ESC_B") [ "$POS" -gt 1 ] && { POS=$((POS - 1)); redraw; }; continue ;;
            "$ESC_F") [ "$POS" -le "${#LINE}" ] && { POS=$((POS + 1)); redraw; }; continue ;;
            "$ESC_K") kill_to_end; redraw; continue ;;
            "$ESC_U") kill_to_start; redraw; continue ;;
            "$ESC_W") kill_word; redraw; continue ;;
            "$ESC_R")
                SEARCH=''
                rsearch_draw
                while :; do
                    C2=$(dd bs=1 count=1 2>/dev/null; printf x)
                    C2=${C2%x}
                    [ -z "$C2" ] && cleanup
                    case "$C2" in
                        "$CR"|"$NL")
                            LINE=$SEARCH_HIT
                            POS=$((${#LINE} + 1))
                            redraw
                            break
                            ;;
                        "$ESC_ETX")
                            emit "^C$NL"
                            LINE=''; POS=1
                            break
                            ;;
                        "$BRK")
                            _sk=$(( ${#SEARCH} - 1 ))
                            if [ "$_sk" -le 0 ]; then SEARCH=''; else
                                SEARCH=$(printf '%s' "$SEARCH" | cut -c1-"$_sk")
                            fi
                            rsearch_draw
                            continue
                            ;;
                        "$ESC_R") rsearch_next; continue ;;
                        *)
                            SEARCH="$SEARCH$C2"
                            rsearch_draw
                            continue
                            ;;
                    esac
                done
                continue
                ;;
            "$ESC_ESC")
                continue
                ;;
            *)
                ins "$C"
                redraw
                continue
                ;;
        esac
    done
done
